{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.vue", "api/src/**/*.ts", "packages/contracts/src/**/*.ts", "tests/**/*.ts", "web/vite.config.ts"]
}
