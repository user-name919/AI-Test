{
  "name": "quality-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @quality-ai/api dev",
    "dev:web": "pnpm --filter @quality-ai/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @quality-ai/web preview",
    "start:api": "pnpm --filter @quality-ai/api start",
    "test": "pnpm test:unit && pnpm build",
    "test:unit": "pnpm --filter @quality-ai/api test && pnpm test:integration",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:ui": "node --import tsx --test tests/ui/*.test.ts",
    "typecheck": "pnpm -r typecheck && vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint build worker api/src api/scripts packages/contracts/src web/src web/vite.config.ts tests evals",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@quality-ai/contracts": "workspace:*",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.4.0",
    "playwright": "1.62.1",
    "promptfoo": "0.123.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "vue": "3.5.22",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.3.9",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
